# Copy to .env and fill in the real values. Never commit .env.
# Keep the single quotes: these values can contain # and spaces.
# Leave DJANGO_DEBUG=False on servers. Use True only on your own machine.
DJANGO_DEBUG=False
# Comma-separated, no spaces. Include every domain that serves this app.
DJANGO_ALLOWED_HOSTS=backend.barakapishoriricemillers.co.ke,127.0.0.1
DJANGO_SECRET_KEY='change-me'
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD='change me'

DB_NAME=barakamills_db
DB_USER=baraka_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
